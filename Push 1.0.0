#include <WiFi.h>
#include <PubSubClient.h>
#include <HTTPUpdate.h>
#include <WiFiClientSecure.h>

// ==========================================
// 1. ตั้งค่า Wi-Fi & MQTT Broker
// ==========================================
const char* ssid             = "Nugget M";
const char* password         = "18112547";

const char* mqtt_server      = "10.242.107.116";
const int   mqtt_port        = 1883;

const char* topic_ota        = "esp32_arun/ota";      
const char* topic_ver        = "esp32_arun/version";  
const char* firmware_version = "v1.0.0";              

#define LED_PIN 2  

WiFiClient espClient;
PubSubClient mqttClient(espClient);

// ==========================================
// 2. ฟังก์ชัน OTA (อัปเดตเฟิร์มแวร์)
// ==========================================
void performOTA(String url) {
  Serial.println("\n------------------------------------");
  Serial.println("[OTA] Received URL: " + url);
  Serial.println("[OTA] Downloading and updating firmware...");

  WiFiClientSecure secureClient;
  secureClient.setInsecure(); 
  secureClient.setTimeout(120);

  // รองรับ Redirect บน ESP32
  httpUpdate.setFollowRedirects(HTTPC_FORCE_FOLLOW_REDIRECTS);

  t_httpUpdate_return ret = httpUpdate.update(secureClient, url);

  switch (ret) {
    case HTTP_UPDATE_FAILED:
      Serial.printf("[OTA] Update Failed! Error (%d): %s\n", 
                    httpUpdate.getLastError(), 
                    httpUpdate.getLastErrorString().c_str());
      break;

    case HTTP_UPDATE_NO_UPDATES:
      Serial.println("[OTA] No updates found on server.");
      break;

    case HTTP_UPDATE_OK:
      Serial.println("[OTA] Update Success! Restarting ESP32...");
      Serial.println("------------------------------------\n");
      delay(1000);
      ESP.restart();
      break;
  }
}

// ==========================================
// 3. Callback & Reconnect Management
// ==========================================
void mqttCallback(char* topic, byte* payload, unsigned int length) {
  String message = "";
  for (unsigned int i = 0; i < length; i++) {
    message += (char)payload[i];
  }
  message.trim();

  Serial.print("[MQTT] Message arrived on topic [");
  Serial.print(topic);
  Serial.println("]");

  if (String(topic) == topic_ota && message.length() > 0) {
    performOTA(message);
  }
}

void reconnectMQTT() {
  while (!mqttClient.connected()) {
    digitalWrite(LED_PIN, LOW);

    Serial.print("[MQTT] Connecting to " + String(mqtt_server) + "...");
    
    // 💡 แก้ไข: ใช้ MAC Address ทำเป็น Client ID ป้องกัน ID ซ้ำกับ Session เก่าใน Docker
    String clientId = "ESP32_Arun_" + WiFi.macAddress();
    
    if (mqttClient.connect(clientId.c_str())) {
      Serial.println(" Connected!");
      
      mqttClient.subscribe(topic_ota);
      
      String statusMsg = "ESP32 Connected | Firmware: " + String(firmware_version) + " | IP: " + WiFi.localIP().toString();
      mqttClient.publish(topic_ver, statusMsg.c_str());

      digitalWrite(LED_PIN, HIGH);
      Serial.println("[SYSTEM] LED status: ON (Connected & Ready)");
    } else {
      Serial.print(" Failed, rc=");
      Serial.print(mqttClient.state()); // ถ้าล้มเหลวจะบอกรหัส Error ออกมา เช่น -2 หรือ -4
      Serial.println(" Retry in 5 seconds...");
      delay(5000);
    }
  }
}

// ==========================================
// 4. Setup & Loop
// ==========================================
void setup() {
  Serial.begin(115200);
  
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  // 💡 กำหนดโหมด Wi-Fi Station ชัดเจน
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  mqttClient.setServer(mqtt_server, mqtt_port);
  mqttClient.setCallback(mqttCallback);
  
  // 💡 เพิ่มขนาด Buffer ให้กับ MQTT ป้องกันแพ็กเกจส่งไม่ผ่าน
  mqttClient.setBufferSize(512);
}

void loop() {
  if (!mqttClient.connected()) {
    reconnectMQTT();
  }
  mqttClient.loop();
}
